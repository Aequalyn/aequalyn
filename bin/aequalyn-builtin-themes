#!/usr/bin/env bash
# aequalyn-builtin-themes -- the themes every installed Aequalyn has.
#
#   aequalyn-builtin-themes           link the built-in themes of the clone that is here
#   aequalyn-builtin-themes --fetch   get the clone first, if there is none (a new install)
#
# Which ones they are is builtin.list in aequalyn-themes. They stay in the clone that
# aequalyn-update keeps ($SRC/aequalyn-themes) and are linked into /usr/share/aequalyn/themes,
# so they take their space once and every update brings their newest. A theme that is a
# folder of its own there is left alone; a link whose theme is gone is removed.
# Not for the live ISO, which has its own themes only.
set -euo pipefail

ROOT=${AEQUALYN_ROOT:-/usr/share/aequalyn}
SRC=${AEQUALYN_SRC:-/var/lib/aequalyn/src}
URL=${AEQUALYN_GIT:-https://github.com/Aequalyn}/aequalyn-themes.git
CLONE="$SRC/aequalyn-themes"
DIR="$ROOT/themes"

fetch=0
case "${1:-}" in
    "") ;;
    --fetch) fetch=1 ;;
    -h|--help) sed -n '2,14p' "$0"; exit 0 ;;
    *) echo "aequalyn-builtin-themes: unknown option $1" >&2; exit 2 ;;
esac
[[ $EUID -eq 0 ]] || { echo "aequalyn-builtin-themes: needs root" >&2; exit 1; }
# the live ISO's themes folder is itself a link, to what it installs from
[[ -L "$DIR" || ! -d "$ROOT" ]] && exit 0

if [[ $fetch -eq 1 && ! -d "$CLONE/.git" ]]; then
    mkdir -p "$SRC"
    new=$(mktemp -d "$SRC/.themes.XXXXXX")
    trap 'rm -rf "$new"' EXIT
    git clone -q --depth 1 --branch main "$URL" "$new/clone"
    chmod -R a+rX "$SRC"
    # an update may have brought it meanwhile
    if [[ ! -d "$CLONE/.git" ]]; then
        rm -rf "$CLONE"
        mv -T "$new/clone" "$CLONE"
    fi
fi
[[ -f "$CLONE/builtin.list" ]] || exit 0

mkdir -p "$DIR"
chmod 755 "$DIR"
while IFS= read -r id; do
    id=${id%%#*}; id=${id//[[:space:]]/}
    [[ $id =~ ^[a-z0-9][a-z0-9_-]*$ && -f "$CLONE/themes/$id/theme.json" ]] || continue
    [[ -e "$DIR/$id" && ! -L "$DIR/$id" ]] && continue
    ln -sfn "$CLONE/themes/$id" "$DIR/$id"
done < "$CLONE/builtin.list"
for l in "$DIR"/*; do
    [[ -L "$l" && "$(readlink "$l")" == "$CLONE/"* && ! -e "$l" ]] && rm -f "$l"
done
exit 0

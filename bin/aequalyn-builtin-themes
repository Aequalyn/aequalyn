#!/usr/bin/env bash
# aequalyn-builtin-themes -- the built-in themes: there to be installed, a few from the start.
#
#   aequalyn-builtin-themes           what the clone that is here has
#   aequalyn-builtin-themes --fetch   get the clone first, if there is none (a new install)
#
# The built-in themes are those of the clone that aequalyn-update keeps ($SRC/aequalyn-themes):
# the Store lists them from it, and installs the ones a user wants. The few in its builtin.list
# are on every system from the start, linked into /usr/share/aequalyn/themes; a folder of its
# own there is left alone. A link that is not in the list (there was a time every theme was
# linked) goes, unless someone here wears that theme or one of its wallpapers.
# Not for the live ISO, which has its own themes only.
set -euo pipefail

ROOT=${AEQUALYN_ROOT:-/usr/share/aequalyn}
SRC=${AEQUALYN_SRC:-/var/lib/aequalyn/src}
URL=${AEQUALYN_GIT:-https://github.com/Aequalyn}/aequalyn-themes.git
CLONE="$SRC/aequalyn-themes"
DIR="$ROOT/themes"

fetch=0
case "${1:-}" in
    "") ;;
    --fetch) fetch=1 ;;
    -h|--help) sed -n '2,14p' "$0"; exit 0 ;;
    *) echo "aequalyn-builtin-themes: unknown option $1" >&2; exit 2 ;;
esac
[[ $EUID -eq 0 ]] || { echo "aequalyn-builtin-themes: needs root" >&2; exit 1; }
# the live ISO's themes folder is itself a link, to what it installs from
[[ -L "$DIR" || ! -d "$ROOT" ]] && exit 0

if [[ $fetch -eq 1 && ! -d "$CLONE/.git" ]]; then
    mkdir -p "$SRC"
    new=$(mktemp -d "$SRC/.themes.XXXXXX")
    trap 'rm -rf "$new"' EXIT
    git clone -q --depth 1 --branch main "$URL" "$new/clone"
    chmod -R a+rX "$SRC"
    # an update may have brought it meanwhile
    if [[ ! -d "$CLONE/.git" ]]; then
        rm -rf "$CLONE"
        mv -T "$new/clone" "$CLONE"
    fi
fi
[[ -f "$CLONE/builtin.list" ]] || exit 0

mkdir -p "$DIR"
chmod 755 "$DIR"
while IFS= read -r id; do
    id=${id%%#*}; id=${id//[[:space:]]/}
    [[ $id =~ ^[a-z0-9][a-z0-9_-]*$ && -f "$CLONE/themes/$id/theme.json" ]] || continue
    [[ -e "$DIR/$id" && ! -L "$DIR/$id" ]] && continue
    ln -sfn "$CLONE/themes/$id" "$DIR/$id"
done < "$CLONE/builtin.list"
# worn by someone: the theme itself, or a wallpaper of it
worn() { # worn <id>
    local home f
    for home in "${HOMES[@]}"; do
        [[ "$(cat "$home/.config/quickshell/theme.conf" 2>/dev/null)" == "theme:$1" ]] && return 0
        [[ "$(readlink "$home/.config/aequalyn/current/theme" 2>/dev/null)" == */themes/"$1" ]] && return 0
        for f in .config/quickshell/wallpaper.conf .config/aequalyn/settings.json .local/state/aequalyn/wallpaper.json; do
            grep -qF "/themes/$1/" "$home/$f" 2>/dev/null && return 0
        done
    done
    return 1
}
HOMES=(/home/* /root)
[[ -z "${AEQUALYN_HOMES:-}" ]] || HOMES=("$AEQUALYN_HOMES"/*)
for l in "$DIR"/*; do
    [[ -L "$l" && "$(readlink "$l")" == "$CLONE/"* ]] || continue
    if [[ ! -e "$l" ]]; then rm -f "$l"; continue; fi
    id=${l##*/}
    sed -e 's/#.*//' -e 's/[[:space:]]//g' "$CLONE/builtin.list" | grep -qxF -- "$id" && continue
    worn "$id" || rm -f "$l"
done
exit 0

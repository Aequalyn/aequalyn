#!/usr/bin/env bash
# aequalyn-plymouth-calibrate -- set the boot-splash progress bar to this
# machine's real post-password boot time.
#
# The Aequalyn Plymouth theme fills its bar over BOOT_SECONDS, counted from the
# moment the LUKS passphrase is submitted. Most of that window on an encrypted
# system is the key derivation, which depends on the CPU, the amount of RAM and
# the keyslot parameters -- so the right value differs per machine.
#
# This script measures the actual key derivation without knowing (or asking
# for) the passphrase: a failing cryptsetup attempt performs exactly the same
# argon2id derivation before it reports "No key available". It then adds the
# tail (dm-crypt setup + mount + switch-root + userspace up to plymouth-quit,
# ~2.5 s typically) and writes the result into the installed theme.
#
# Usage:
#   sudo aequalyn-plymouth-calibrate              measure and apply
#   sudo aequalyn-plymouth-calibrate --tail 2.5   override the fixed tail
#   sudo aequalyn-plymouth-calibrate --dry-run    measure, print, do not write
#   sudo aequalyn-plymouth-calibrate --theme-dir DIR
#
# Re-run it after changing the LUKS keyslot parameters or the CPU. Unencrypted
# systems end up with just the tail value.
set -euo pipefail

THEME_DIR=/usr/share/plymouth/themes/aequalyn
THEME_SCRIPT="$THEME_DIR/aequalyn.script"
TAIL=2.5
DRY_RUN=0
RUNS=3

log()  { printf '\033[0;34m[plymouth-calibrate]\033[0m %s\n' "$*" >&2; }
ok()   { printf '\033[0;32m[plymouth-calibrate]\033[0m %s\n' "$*" >&2; }
warn() { printf '\033[1;33m[plymouth-calibrate]\033[0m %s\n' "$*" >&2; }

usage() { sed -n '3,23p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        --tail)      TAIL=${2:?--tail needs a value}; shift 2 ;;
        --tail=*)    TAIL=${1#*=}; shift ;;
        --runs)      RUNS=${2:?--runs needs a value}; shift 2 ;;
        --runs=*)    RUNS=${1#*=}; shift ;;
        --dry-run)   DRY_RUN=1; shift ;;
        --theme-dir) THEME_DIR=${2:?--theme-dir needs a value}; THEME_SCRIPT="$THEME_DIR/aequalyn.script"; shift 2 ;;
        --theme-dir=*) THEME_DIR=${1#*=}; THEME_SCRIPT="$THEME_DIR/aequalyn.script"; shift ;;
        -h|--help)   usage 0 ;;
        *) warn "unknown argument: $1"; usage 2 ;;
    esac
done

[[ $EUID -eq 0 ]] || { warn "run as root (sudo $0)"; exit 1; }
[[ -f "$THEME_SCRIPT" ]] || { warn "$THEME_SCRIPT not found; install the theme first"; exit 1; }

case "$TAIL" in
    ''|*[!0-9.]*|*.*.*) warn "invalid --tail: $TAIL"; exit 2 ;;
esac
case "$RUNS" in
    ''|*[!0-9]*) warn "invalid --runs: $RUNS"; exit 2 ;;
esac

current=$(sed -n 's/^BOOT_SECONDS = \([0-9.]*\);.*/\1/p' "$THEME_SCRIPT" | head -1)
log "theme: $THEME_SCRIPT (current BOOT_SECONDS=${current:-unset})"

# ---------------------------------------------------------------- root device --
root_src=$(findmnt -no SOURCE / 2>/dev/null || true)
root_src=${root_src%%\[*}          # btrfs subvolumes come back as dev[/subvol]
luks_dev=""
if [[ -n $root_src ]]; then
    info=$(cryptsetup status "$root_src" 2>/dev/null || true)
    if printf '%s\n' "$info" | grep -q '^ *type: *LUKS'; then
        luks_dev=$(printf '%s\n' "$info" | awk '/^ *device:/ {print $2; exit}')
    fi
fi

kdf_ms=0
if [[ -z $luks_dev ]]; then
    warn "root ($root_src) is not a LUKS device; using the tail only"
else
    log "measuring key derivation on $luks_dev (wrong key, no passphrase needed)"
    best=""
    for i in $(seq 1 "$RUNS"); do
        start=${EPOCHREALTIME/./}
        head -c 32 /dev/urandom | cryptsetup open --test-passphrase --key-file=- "$luks_dev" >/dev/null 2>&1 || true
        end=${EPOCHREALTIME/./}
        ms=$(( (end - start) / 1000 ))
        log "  run $i: ${ms} ms"
        if [[ -z $best || $ms -lt $best ]]; then best=$ms; fi
    done
    kdf_ms=$best
fi

# ------------------------------------------------------------------- result ---
total=$(awk -v k="$kdf_ms" -v t="$TAIL" 'BEGIN { printf "%.1f", k / 1000 + t }')

log "key derivation: $((kdf_ms / 1000)).$(printf '%03d' $((kdf_ms % 1000))) s, tail: ${TAIL} s"
ok "BOOT_SECONDS = $total"

if [[ $DRY_RUN -eq 1 ]]; then
    log "--dry-run: not writing"
    exit 0
fi

sed -i "s/^BOOT_SECONDS = .*/BOOT_SECONDS = $total;/" "$THEME_SCRIPT"
grep -n '^BOOT_SECONDS' "$THEME_SCRIPT" >&2
ok "written; rebuild the initramfs so the boot splash picks it up: mkinitcpio -P"

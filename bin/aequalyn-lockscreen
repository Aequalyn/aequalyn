#!/bin/bash
# aequalyn-lockscreen: the ready made lock screens, drawn by hyprlock. "custom" is not one
# of them: that is the shell's own lock (aequalyn-lock picks the one chosen in Settings).
#
#   aequalyn-lockscreen list            the designs
#   aequalyn-lockscreen apply [name]    write ~/.config/hypr/hyprlock.conf from the one
#                                       chosen in Settings (or `name`); "classic" is the
#                                       one made from the wallpaper
#   aequalyn-lockscreen try <name>      lock now with that one
#
# The colours come from ~/.config/aequalyn/lock-palette.json, which the shell writes
# whenever the theme changes; the wallpaper is the one on the screen now (a still of it
# when it moves). aequalyn-wallpaper runs `apply` on every wallpaper change, and the
# shell on every theme change, so the lock always matches what you chose.
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
DIR="$CONF/hypr/lockscreens"
OUT="$CONF/hypr/hyprlock.conf"
PALETTE="$CONF/aequalyn/lock-palette.json"
SETTINGS="$CONF/aequalyn/settings.json"

chosen() {
    local s=""
    [[ -f "$SETTINGS" ]] && s=$(jq -r '.power.lockStyle // empty' "$SETTINGS" 2>/dev/null || true)
    echo "${s:-classic}"
}

# a palette colour as rrggbb, or the fallback
color() {
    local v=""
    [[ -f "$PALETTE" ]] && v=$(jq -r --arg k "$1" '.[$k] // empty' "$PALETTE" 2>/dev/null || true)
    v=${v#\#}
    [[ "$v" =~ ^[0-9a-fA-F]{6}$ ]] && echo "${v,,}" || echo "$2"
}

# the desktop's UI font
font() {
    local f=""
    [[ -f "$SETTINGS" ]] && f=$(jq -r '.uiFont // empty' "$SETTINGS" 2>/dev/null || true)
    [[ "$f" =~ ^[A-Za-z0-9\ ._+-]+$ ]] && echo "$f" || echo "JetBrainsMono Nerd Font"
}

# the wallpaper on the screen now; a still frame of it when it is a moving one
wallpaper() {
    local p="" cache="${XDG_CACHE_HOME:-$HOME/.cache}/aequalyn/current-wallpaper"
    [[ -f "$cache" ]] && p=$(cat "$cache")
    if [[ -n "$p" && -f "$p" && "${p,,}" =~ \.(mp4|webm|mkv|mov)$ ]]; then
        local run="${XDG_RUNTIME_DIR:-/tmp}/aequalyn-lock" key still
        mkdir -p -m 700 "$run"
        key=$(printf '%s' "$p" | md5sum | cut -c1-16)
        still="$run/wall-$key.jpg"
        [[ -s "$still" ]] || ffmpeg -nostdin -loglevel error -y -ss 1 -i "$p" -frames:v 1 "$still" >/dev/null 2>&1 \
            || ffmpeg -nostdin -loglevel error -y -i "$p" -frames:v 1 "$still" >/dev/null 2>&1 || true
        [[ -s "$still" ]] && p="$still" || p=""
    fi
    # nothing known (or it is gone): the one the lock screen had
    if [[ -z "$p" || ! -f "$p" ]]; then
        p=""
        [[ -f "$OUT" ]] && p=$(awk '/^[[:space:]]*background[[:space:]]*\{/{b=1} b && /^[[:space:]]*path[[:space:]]*=/{sub(/^[^=]*=[[:space:]]*/,""); print; exit}' "$OUT")
        [[ -z "$p" && -f "$DIR/.wallpaper" ]] && p=$(cat "$DIR/.wallpaper")
    fi
    echo "$p"
}

render() {
    local name=$1 dest=$2 wall
    wall=$(wallpaper)
    [[ -n "$wall" ]] && printf '%s' "$wall" > "$DIR/.wallpaper"
    sed -e "s|{{BG}}|$(color bgBase 141414)|g" \
        -e "s|{{SURFACE}}|$(color bgSurface 1e1e1e)|g" \
        -e "s|{{BORDER}}|$(color bgBorder 333333)|g" \
        -e "s|{{TEXT}}|$(color textPrimary e0e0e0)|g" \
        -e "s|{{MUTED}}|$(color textMuted 8a8a8a)|g" \
        -e "s|{{ACCENT}}|$(color accentPrimary 7aa2f7)|g" \
        -e "s|{{ACCENT2}}|$(color accentCyan 7dcfff)|g" \
        -e "s|{{RED}}|$(color accentRed f7768e)|g" \
        -e "s|{{FONT}}|$(font)|g" \
        -e "s|{{WALL}}|${wall//|/\\|}|g" \
        "$DIR/$name.conf" > "$dest"
    # What every design shares. The password alone unlocks here: a face scan that fails
    # must not count as a wrong password (pam_faillock would lock the account out). The
    # face is for Space (aequalyn-lock-face), and this line says how that goes.
    {
        printf '\ngeneral {\n    ignore_empty_input = true\n}\n'
        if [[ -f /etc/pam.d/aequalyn-lock-password ]]; then
            printf '\nauth {\n    pam:enabled = true\n    pam:module = aequalyn-lock-password\n}\n'
        fi
        printf '\nlabel {\n    monitor =\n    text = cmd[update:0:1] "%s/.local/bin/aequalyn-lock-face" status\n' "$HOME"
        printf '    font_size = 11\n    font_family = $font\n    color = rgba(%sff)\n' "$(color textMuted 8a8a8a)"
        printf '    position = 0, 24\n    halign = center\n    valign = bottom\n}\n'
    } >> "$dest"
}

case "${1:-}" in
    list)
        for f in "$DIR"/*.conf; do [[ -e "$f" ]] && basename "$f" .conf; done
        ;;
    apply)
        name=${2:-$(chosen)}
        # the shell's own lock has no hyprlock design to write
        [[ "$name" == custom ]] && exit 0
        # Classic: drawn from its own template too when there is one, so its colours and
        # wallpaper follow the theme; else the one made from the wallpaper, kept aside
        if [[ "$name" == classic && ! -f "$DIR/classic.conf" ]]; then
            [[ -f "$DIR/.classic" ]] && cp -f "$DIR/.classic" "$OUT"
            exit 0
        fi
        [[ -f "$DIR/.classic" || ! -f "$OUT" ]] || grep -q "^# Aequalyn lock screen: " "$OUT" || cp -f "$OUT" "$DIR/.classic"
        [[ "$name" =~ ^[a-z0-9-]+$ && -f "$DIR/$name.conf" ]] || { echo "aequalyn-lockscreen: no design '$name'" >&2; exit 1; }
        tmp=$(mktemp "$OUT.XXXXXX")
        render "$name" "$tmp"
        mv -f "$tmp" "$OUT"
        ;;
    try)
        # locks for real, with this design ("custom" is the shell's own lock)
        if [[ "${2:-}" =~ ^[a-z0-9-]+$ ]]; then export AEQUALYN_LOCK_STYLE=$2; fi
        exec "$HOME/.local/bin/aequalyn-lock" lock
        ;;
    *)
        sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
        ;;
esac

#!/usr/bin/env bash
# aequalyn-update -- bring this machine up to the newest Aequalyn on GitHub.
#
#   aequalyn-update            get the newest Aequalyn and its shell, re-apply them to
#                              your home and restart the shell
#   aequalyn-update --no-pull  re-apply what is already here, without GitHub
#
# Run it as yourself, not as root: it asks for your password for the two system copies
# (/usr/share/aequalyn and the shell inside it, shell/), which belong to root.
#
# Your settings stay as they are. install.sh keeps everything you changed (settings,
# layouts, docks, default apps, terminal and GTK preferences, colours, wallpaper and
# theme) and first saves a copy in ~/.local/state/aequalyn/backups.
#
# Migrations in migrations/ (of the newest Aequalyn) each run once, as root, in name
# order. A migration exits 0 when done, or 3 to be tried again on the next update.
#
# It lives in Aequalyn's bin/, so every update also brings the newest updater.
# AEQUALYN_ROOT, AEQUALYN_BIN_DIR and AEQUALYN_GIT point it elsewhere, for testing.
set -Eeuo pipefail

# Everything below is one function, called on the last line together with `exit`: bash
# has then read the whole script before it runs any of it. An update replaces this very
# file (in /usr/local/bin and ~/.local/bin); read line by line, the rest would come
# from the new file, half way through it ("syntax error near unexpected token").
# The commands are also swapped in as new files (a rename), so a running copy is never
# changed under it.
main() {
    DO_PULL=1
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-pull) DO_PULL=0; shift ;;
            -h|--help) sed -n '2,19p' "$0"; exit 0 ;;
            *) printf 'unknown option: %s\n' "$1" >&2; exit 2 ;;
        esac
    done

    AQ_ROOT=${AEQUALYN_ROOT:-/usr/share/aequalyn}
    SHELL_DIR="$AQ_ROOT/shell"
    BIN_DIR=${AEQUALYN_BIN_DIR:-/usr/local/bin}
    AEQUALYN_GIT=${AEQUALYN_GIT:-https://github.com/Aequalyn}
    SYSTEM_URL="$AEQUALYN_GIT/aequalyn.git"
    SHELL_URL="$AEQUALYN_GIT/aequalyn-shell.git"
    LOCKSCREENS_URL="$AEQUALYN_GIT/aequalyn-lockscreens.git"

    [[ -d "$AQ_ROOT" ]] || { echo "aequalyn-update: $AQ_ROOT not found" >&2; exit 1; }

    SUDO=""
    [[ $EUID -ne 0 ]] && SUDO=sudo

    # Say where it stopped: a failed step leaves everything after it as it was.
    step="starting"
    trap 'echo; echo "aequalyn-update: stopped while $step." >&2; echo "Nothing after that step was changed; your settings are as they were." >&2' ERR

    # git in a root-owned clone. safe.directory is given per command, so git's global
    # config isn't touched (it used to grow by a line on every update).
    g() { local dir=$1; shift; $SUDO git -c safe.directory="$dir" -C "$dir" "$@"; }

    # Puts the newest main from GitHub in place in a root-owned clone. A fetch and a hard
    # reset, not a pull: it can't stop half way on a merge, and works even if the history
    # on GitHub was rewritten. Untracked files (the system tree's shell/) are left alone.
    # The trees under /usr/share belong to root but are read by you: install.sh copies
    # them as your user, and a checkout under sudo's umask leaves new files unreadable
    # (root:root 600), which broke every step that followed. Make the whole tree
    # readable again after every sync.
    sync_clone() { # <dir> <url> <what>
        local dir=$1 url=$2 what=$3
        step="downloading the newest $what"
        g "$dir" fetch -q --depth 1 "$url" main
        step="putting the newest $what in place"
        g "$dir" checkout -q -f -B main FETCH_HEAD
        g "$dir" reset -q --hard FETCH_HEAD
        $SUDO chmod -R a+rX "$dir"
    }

    # Runs the migrations/*.sh of the newest Aequalyn that are not recorded yet, in name
    # order, as root. Each one that finishes is recorded in $MIGRATIONS_DONE; a failure
    # stops the update, so the next run tries it again.
    MIGRATIONS_DONE=/var/lib/aequalyn/migrations.done
    run_migrations() {
        local dir="$AQ_ROOT/migrations" f name rc
        [[ -d "$dir" ]] || return 0
        $SUDO mkdir -p "$(dirname "$MIGRATIONS_DONE")"
        $SUDO touch "$MIGRATIONS_DONE"
        while IFS= read -r f; do
            [[ -f "$f" ]] || continue
            name=$(basename "$f")
            grep -qxF "$name" "$MIGRATIONS_DONE" && continue
            echo "==> migration $name"
            rc=0
            $SUDO bash "$f" || rc=$?
            if [[ $rc -eq 3 ]]; then
                echo "    not ready yet; it runs on the next update"
                continue
            fi
            if [[ $rc -ne 0 ]]; then
                echo "aequalyn-update: migration $name failed (exit $rc); it runs again next time." >&2
                exit 1
            fi
            printf '%s\n' "$name" | $SUDO tee -a "$MIGRATIONS_DONE" >/dev/null
        done < <(printf '%s\n' "$dir"/*.sh | LC_ALL=C sort)
    }

    if [[ $DO_PULL -eq 1 ]]; then
        if [[ ! -d "$AQ_ROOT/.git" ]]; then
            echo "aequalyn-update: $AQ_ROOT is not a git clone, so it can't be updated from GitHub." >&2
            echo "  Re-install Aequalyn, or make it one:" >&2
            echo "  sudo git init $AQ_ROOT && sudo git -C $AQ_ROOT remote add origin $SYSTEM_URL" >&2
            exit 1
        fi
        echo "==> getting the newest Aequalyn"
        sync_clone "$AQ_ROOT" "$SYSTEM_URL" "Aequalyn"

        echo "==> getting the newest shell"
        if [[ -d "$SHELL_DIR/.git" ]]; then
            sync_clone "$SHELL_DIR" "$SHELL_URL" "shell"
        else
            # an old bundled copy: replaced by a clone, swapped in only once it is complete
            step="downloading the shell"
            $SUDO rm -rf "$SHELL_DIR.new"
            $SUDO git clone -q --depth 1 "$SHELL_URL" "$SHELL_DIR.new"
            step="putting the shell in place"
            $SUDO rm -rf "$SHELL_DIR"
            $SUDO mv "$SHELL_DIR.new" "$SHELL_DIR"
        fi
    fi

    # Optional SDDM lock-screen themes: only sync if the user opted in (marker present).
    if [[ -f /usr/share/aequalyn/lockscreens.enabled ]]; then
        step="getting the newest lock screens"
        LOCKSCREENS_DIR="$AQ_ROOT/lockscreens"
        if [[ $DO_PULL -eq 1 ]]; then
            if [[ -d "$LOCKSCREENS_DIR/.git" ]]; then
                sync_clone "$LOCKSCREENS_DIR" "$LOCKSCREENS_URL" "lock screens"
            else
                $SUDO rm -rf "$LOCKSCREENS_DIR.new"
                $SUDO git clone -q --depth 1 "$LOCKSCREENS_URL" "$LOCKSCREENS_DIR.new"
                $SUDO rm -rf "$LOCKSCREENS_DIR"
                $SUDO mv "$LOCKSCREENS_DIR.new" "$LOCKSCREENS_DIR"
            fi
        fi
        if [[ -d "$LOCKSCREENS_DIR" ]]; then
            step="applying lock screens"
            $SUDO mkdir -p /usr/share/sddm/themes /usr/share/fonts/qylock
            for t in "$LOCKSCREENS_DIR"/*/; do
                [[ -d "$t" ]] || continue
                name=$(basename "$t")
                $SUDO rm -rf "/usr/share/sddm/themes/$name"
                $SUDO cp -r "$t" "/usr/share/sddm/themes/$name"
            done
            find "$LOCKSCREENS_DIR" -type f \( -name "*.ttf" -o -name "*.otf" \) -exec $SUDO cp -n {} /usr/share/fonts/qylock/ \; 2>/dev/null || true
            $SUDO fc-cache -f 2>/dev/null || true
            printf '1\n' | $SUDO tee /usr/share/aequalyn/lockscreens.enabled >/dev/null
        fi
    fi

    echo "==> re-applying Aequalyn to $HOME (your settings stay as they are)"
    step="re-applying Aequalyn to your home"
    AEQUALYN_SHELL_DIR="$SHELL_DIR" bash "$AQ_ROOT/install.sh" --target "$HOME" --skip-hypr

    echo "==> setting up the agent skills (.agents, .claude, ...)"
    step="setting up the agent skills"
    if [[ -x "$AQ_ROOT/bin/aequalyn-provision-user" ]]; then
        AEQUALYN_PATH="$AQ_ROOT" AEQUALYN_SHELL_DIR="$SHELL_DIR" bash "$AQ_ROOT/bin/aequalyn-provision-user" || true
    elif command -v aequalyn-provision-user >/dev/null 2>&1; then
        AEQUALYN_PATH="$AQ_ROOT" AEQUALYN_SHELL_DIR="$SHELL_DIR" aequalyn-provision-user || true
    fi
    # The skill folders exist even when no provisioner is there (older installs): link any
    # skill the shell ships.
    mkdir -p "$HOME/.agents/skills" "$HOME/.claude/skills" "$HOME/.codex/skills" "$HOME/.pi/agent/skills" "$HOME/.gemini/config/skills" "$HOME/.hermes/skills"
    SKILLS_SRC=""
    for base in "$SHELL_DIR" "$SHELL_DIR/default"; do
        if [[ -d "$base/agents/skills" ]]; then SKILLS_SRC="$base/agents/skills"; break; fi
    done
    if [[ -n "$SKILLS_SRC" ]]; then
        for skill in "$SKILLS_SRC"/*/; do
            [[ -d "$skill" ]] || continue
            skill=${skill%/}
            name=${skill##*/}
            for d in .agents/skills .claude/skills .codex/skills .pi/agent/skills .gemini/config/skills .hermes/skills; do
                ln -sfn "$skill" "$HOME/$d/$name"
            done
        done
    fi

    echo "==> refreshing the aequalyn commands in $BIN_DIR"
    step="refreshing the aequalyn commands"
    for f in "$AQ_ROOT/bin/"*; do
        [[ -f "$f" ]] || continue
        n=$(basename "$f")
        $SUDO cp -a "$f" "$BIN_DIR/.$n.new"
        $SUDO mv -f "$BIN_DIR/.$n.new" "$BIN_DIR/$n"
    done
    $SUDO chmod 755 "$BIN_DIR"/aequalyn-* 2>/dev/null || true

    echo "==> running migrations"
    step="running migrations"
    run_migrations

    echo "==> restarting the shell"
    step="restarting the shell"
    if command -v aequalyn-watchdog >/dev/null 2>&1 && aequalyn-watchdog status >/dev/null 2>&1; then
        # The supervisor owns the shell and the sandboxed plugin processes:
        # tell it, so the restart is planned (not counted as crashes), and the
        # sandboxed plugins come back on the update's new code too. It is
        # restarted too: stop leaves the desktop running while the old
        # supervisor steps aside, start brings the freshly installed one back
        # (it adopts the running shell), and restart-all then puts the shell
        # and every plugin onto the new code as one planned restart. If the
        # new binary cannot start, the stop marker goes with it, so the
        # shell's keep-alive (ensure) is not left respecting a stale one.
        aequalyn-watchdog stop >/dev/null 2>&1 || true
        if ! aequalyn-watchdog start >/dev/null 2>&1; then
            rm -f "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/aequalyn-watchdog.stopped" 2>/dev/null || true
        fi
        aequalyn-watchdog restart-all >/dev/null 2>&1 || true
    else
        if pgrep -x qs >/dev/null 2>&1; then
            pkill -x qs 2>/dev/null || true
            for _ in $(seq 1 25); do
                pgrep -x qs >/dev/null 2>&1 || break
                sleep 0.2
            done
        fi
        if command -v aequalyn-session-start >/dev/null 2>&1; then
            aequalyn-session-start >/dev/null 2>&1 || true
        else
            QS_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell"
            if command -v qs >/dev/null 2>&1; then
                nohup qs -n -d -p "$QS_CONFIG" >/dev/null 2>&1 &
                disown
            fi
        fi
    fi

    echo "==> done: Aequalyn $(g "$AQ_ROOT" rev-parse --short HEAD 2>/dev/null || echo '?'), shell $(g "$SHELL_DIR" rev-parse --short HEAD 2>/dev/null || echo '?')."
    echo "    Your settings are as you left them; a copy is in ~/.local/state/aequalyn/backups."
}

main "$@"; exit $?

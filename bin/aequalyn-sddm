#!/usr/bin/env bash
# aequalyn-sddm -- manage the SDDM login screen theme, autologin and preview.
#
#   aequalyn-sddm list                       print installed SDDM theme names
#   aequalyn-sddm current                    print the current theme name (or empty)
#   aequalyn-sddm apply <name>               set SDDM's theme (through the gate)
#   aequalyn-sddm autologin on|off           enable/disable auto-login (through the gate)
#   aequalyn-sddm autologin status           "on" or "off"
#   aequalyn-sddm preview <name> [seconds]   run the greeter in a window (no root)
#   aequalyn-sddm install                    install the theme pack (through the gate)
#
# AUTHORISATION: the privileged commands go through the desktop's one gate
# (aequalyn-watchdog exec-root --as settings sddm-...): an approval window
# names the command, the password goes to sudo on a pipe, and the root
# halves below are only ever started by the watchdog (sudo resets HOME but
# always keeps SUDO_USER, so the staged file is re-found through it, and
# nothing in it is trusted beyond strict validation). From a terminal, run
# the same thing yourself with sudo.
set -euo pipefail

THEMES_DIR=/usr/share/sddm/themes
SDDM_CONF_DIR=/etc/sddm.conf.d
THEME_CONF="$SDDM_CONF_DIR/aequalyn-theme.conf"
AUTOLOGIN_CONF="$SDDM_CONF_DIR/aequalyn-autologin.conf"
STAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/aequalyn/gate"
STAGE_FILE="$STAGE_DIR/sddm.json"

stage_gate() { # <json>
    mkdir -p "$STAGE_DIR"
    printf '%s\n' "$1" > "$STAGE_FILE"
}

session_name() {
    if [[ -f /usr/share/wayland-sessions/aequalyn.desktop ]]; then echo aequalyn
    elif [[ -f /usr/share/wayland-sessions/hyprland.desktop ]]; then echo hyprland
    else echo hyprland; fi
}

# ---- root bodies, shared by the gate and a manual sudo ----------------------
do_install() {
    AQ_ROOT=${AEQUALYN_ROOT:-/usr/share/aequalyn}
    LOCKSCREENS_DIR="$AQ_ROOT/lockscreens"
    LOCKSCREENS_URL="https://github.com/Aequalyn/aequalyn-lockscreens.git"
    mkdir -p "$AQ_ROOT"
    if [[ -d "$LOCKSCREENS_DIR/.git" ]]; then
        git -C "$LOCKSCREENS_DIR" fetch -q --depth 1 origin main 2>/dev/null || true
        git -C "$LOCKSCREENS_DIR" reset -q --hard origin/main 2>/dev/null || true
    else
        rm -rf "$LOCKSCREENS_DIR"
        git clone -q --depth 1 "$LOCKSCREENS_URL" "$LOCKSCREENS_DIR" 2>/dev/null || { echo "clone failed" >&2; exit 1; }
    fi
    [[ -d "$LOCKSCREENS_DIR" ]] || { echo "no lockscreens dir" >&2; exit 1; }
    mkdir -p "$THEMES_DIR" /usr/share/fonts/qylock
    for t in "$LOCKSCREENS_DIR"/*/; do
        [[ -d "$t" ]] || continue
        n=$(basename "$t")
        rm -rf "$THEMES_DIR/$n"
        cp -r "$t" "$THEMES_DIR/$n"
    done
    find "$LOCKSCREENS_DIR" -type f \( -name "*.ttf" -o -name "*.otf" \) -exec cp -n {} /usr/share/fonts/qylock/ \; 2>/dev/null || true
    fc-cache -f 2>/dev/null || true
    mkdir -p /usr/share/aequalyn
    printf '1\n' > /usr/share/aequalyn/lockscreens.enabled
    echo "installed"
}

do_apply() { # <name>
    local name=$1
    [[ -d "$THEMES_DIR/$name" ]] || { echo "aequalyn-sddm: unknown theme: $name" >&2; exit 1; }
    mkdir -p "$SDDM_CONF_DIR"
    cat > "$THEME_CONF" <<EOF
[Theme]
Current=$name
EOF
    echo "applied: $name"
}

do_autologin_on() { # <user>
    local user=$1
    getent passwd "$user" >/dev/null || { echo "aequalyn-sddm: no such user: $user" >&2; exit 1; }
    mkdir -p "$SDDM_CONF_DIR"
    cat > "$AUTOLOGIN_CONF" <<EOF
[Autologin]
User=$user
Session=$(session_name)
Relogin=false
EOF
    echo "autologin on: $user"
}

do_autologin_off() {
    rm -f "$AUTOLOGIN_CONF"
    echo "autologin off"
}

# ---- the gate halves, run as root by the watchdog's exec-root ----------------
# Nothing here is trusted from the user side beyond strict validation: the
# theme must be an installed one, the user must exist, the directories are
# the script's own constants.
gate_root_home() {
    local user="${SUDO_USER:-}" home=""
    [[ -n $user ]] || { echo "aequalyn-sddm: no SUDO_USER: not started by the gate" >&2; exit 1; }
    home=$(getent passwd "$user" | cut -d: -f6)
    [[ -n $home ]] || { echo "aequalyn-sddm: no home for $user" >&2; exit 1; }
    printf '%s' "$home"
}

case "${1:-}" in
    gate-install)
        [[ ${EUID} -eq 0 ]] || { echo "needs root" >&2; exit 1; }
        do_install
        exit 0
        ;;
    gate-apply)
        [[ ${EUID} -eq 0 ]] || { echo "needs root" >&2; exit 1; }
        stage="$(gate_root_home)/.local/state/aequalyn/gate/sddm.json"
        name=$(jq -r '.theme // empty' "$stage" 2>/dev/null || true)
        [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || { echo "staged theme is missing or invalid" >&2; exit 1; }
        do_apply "$name"
        exit 0
        ;;
    gate-autologin)
        [[ ${EUID} -eq 0 ]] || { echo "needs root" >&2; exit 1; }
        stage="$(gate_root_home)/.local/state/aequalyn/gate/sddm.json"
        action=$(jq -r '.action // empty' "$stage" 2>/dev/null || true)
        user=$(jq -r '.user // empty' "$stage" 2>/dev/null || true)
        case "$action" in
            on)  [[ $user =~ ^[a-z_][a-z0-9_-]*$ ]] || { echo "staged user is missing or invalid" >&2; exit 1; }
                  do_autologin_on "$user" ;;
            off) do_autologin_off ;;
            *)   echo "staged autologin action is invalid" >&2; exit 1 ;;
        esac
        exit 0
        ;;
esac

# ---- user half: the privileged commands ride the gate ------------------------
gate_run() { # <action>
    local reply rc=0
    reply=$(aequalyn-watchdog exec-root --as settings "$1" 2>&1) || rc=$?
    if [[ $rc -ne 0 ]]; then
        if printf '%s' "$reply" | grep -q "not a supervised process"; then
            echo "aequalyn-sddm: the gate only answers the desktop; from a terminal, use sudo directly." >&2
            return 1
        fi
        echo "aequalyn-sddm: the gate answered: $(printf '%s' "$reply" | tail -n +2 | tr -d '\n ' | cut -c1-160)" >&2
        return $rc
    fi
    return 0
}

cmd=${1:-}
case "$cmd" in
    install)
        if [[ ${EUID} -eq 0 ]]; then do_install
        else gate_run sddm-install
        fi
        ;;
    list)
        for d in "$THEMES_DIR"/*/; do
            [[ -d "$d" ]] || continue
            b=$(basename "$d")
            [[ -f "$d/metadata.desktop" || -f "$d/Main.qml" ]] || continue
            # skip SDDM's built-in default themes
            case "$b" in elarun|maldives|maya) continue ;; esac
            echo "$b"
        done | sort
        ;;
    current)
        if [[ -f "$THEME_CONF" ]]; then
            awk -F= '/^[[:space:]]*Current[[:space:]]*=/{gsub(/[[:space:]]/,"",$2); print $2}' "$THEME_CONF" | tail -1
        fi
        ;;
    apply)
        name=${2:?theme name required}
        if [[ ${EUID} -eq 0 ]]; then
            do_apply "$name"
        else
            stage_gate "{\"theme\": \"$name\", \"action\": \"apply\"}"
            gate_run sddm-apply
        fi
        ;;
    autologin)
        sub=${2:-status}
        case "$sub" in
            status)
                if [[ -f "$AUTOLOGIN_CONF" ]] && grep -q '^User=' "$AUTOLOGIN_CONF" 2>/dev/null; then
                    u=$(awk -F= '/^User=/{print $2}' "$AUTOLOGIN_CONF" | tail -1)
                    [[ -n "$u" && "$u" != "__USERNAME__" ]] && echo on || echo off
                else
                    echo off
                fi
                ;;
            on|off)
                if [[ ${EUID} -eq 0 ]]; then
                    user=${3:-${SUDO_USER:-$USER}}
                    [[ -z "$user" || "$user" == "root" ]] && user=$(awk -F: '$3==1000{print $1; exit}' /etc/passwd)
                    if [[ "$sub" == "on" ]]; then do_autologin_on "$user"; else do_autologin_off; fi
                else
                    user=${3:-$USER}
                    stage_gate "{\"action\": \"$sub\", \"user\": \"$user\"}"
                    gate_run sddm-autologin
                fi
                ;;
            *) echo "usage: aequalyn-sddm autologin {on|off|status} [user]" >&2; exit 2 ;;
        esac
        ;;
    preview)
        name=${2:?theme name required}
        secs=${3:-10}
        [[ -d "$THEMES_DIR/$name" ]] || { echo "aequalyn-sddm: unknown theme: $name" >&2; exit 1; }
        if ! command -v sddm-greeter-qt6 >/dev/null 2>&1; then
            echo "aequalyn-sddm: sddm-greeter-qt6 not found" >&2; exit 1
        fi
        # hide the Settings panel so the preview is visible (greeter is fullscreen
        # on both outputs in test mode, but sits below layer-shell surfaces)
        qs ipc call aequalyn closeSettings >/dev/null 2>&1 || true
        sleep 0.3
        sddm-greeter-qt6 --test-mode --theme "$THEMES_DIR/$name" &
        greeter_pid=$!
        sleep "$secs"
        kill "$greeter_pid" 2>/dev/null || true
        kill -9 "$greeter_pid" 2>/dev/null || true
        wait "$greeter_pid" 2>/dev/null || true
        # bring Settings back
        qs ipc call aequalyn openSettings >/dev/null 2>&1 || true
        wait "$greeter_pid" 2>/dev/null || true
        echo "preview done"
        ;;
    *)
        echo "usage: aequalyn-sddm {list|current|apply <name>|autologin on|off|status|preview <name> [secs]|install}" >&2
        exit 2
        ;;
esac

#!/usr/bin/env bash
# aequalyn-screenshot -- capture screenshots via grim/slurp/wl-copy.
#
# Usage:
#   aequalyn-screenshot region-clip   select region, save it and copy to clipboard (default)
#   aequalyn-screenshot region-file   select region and save to file only
#   aequalyn-screenshot full-clip     capture full screen, save it and copy to clipboard
#   aequalyn-screenshot full-file     capture full screen and save to file only
#
# Every mode saves a PNG to ~/Pictures/Screenshots/Aequalyn-YYYYmmdd-HHMMSS.png;
# the *-clip modes copy it to the clipboard as well.
# The saved path is printed on success.
set -euo pipefail
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:$PATH"

cmd="${1:-region-clip}"
shots_dir="$HOME/Pictures/Screenshots"

need() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "aequalyn-screenshot: missing required command: $1" >&2
        exit 1
    fi
}

notify() {
    local msg="$1"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a Aequalyn "Screenshot" "$msg" >/dev/null 2>&1 || true
    fi
}

capture_region() {
    need grim
    need slurp
    local geom
    geom=$(slurp 2>/dev/null || true)
    if [[ -z "$geom" ]]; then
        exit 1
    fi
    grim -g "$geom" "$@"
}

capture_full() {
    need grim
    grim "$@"
}

copy_file() {
    need wl-copy
    wl-copy --type image/png < "$1"
}

save_path() {
    mkdir -p "$shots_dir"
    printf '%s/Aequalyn-%s.png\n' "$shots_dir" "$(date +%Y%m%d-%H%M%S)"
}

case "$cmd" in
    region|region-clip)
        out=$(save_path)
        capture_region "$out"
        copy_file "$out"
        notify "Saved to $out (copied to clipboard)"
        echo "$out"
        ;;
    region-file)
        out=$(save_path)
        capture_region "$out"
        notify "Saved to $out"
        echo "$out"
        ;;
    full|full-clip)
        out=$(save_path)
        capture_full "$out"
        copy_file "$out"
        notify "Saved to $out (copied to clipboard)"
        echo "$out"
        ;;
    full-file)
        out=$(save_path)
        capture_full "$out"
        notify "Saved to $out"
        echo "$out"
        ;;
    *)
        echo "usage: aequalyn-screenshot {region-clip|region-file|full-clip|full-file}" >&2
        exit 2
        ;;
esac

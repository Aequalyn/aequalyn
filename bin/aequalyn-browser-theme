#!/usr/bin/env bash
# aequalyn-browser-theme -- let Chromium-based browsers use the Aequalyn bar colour.
#
# Usage:
#   aequalyn-browser-theme sync [--color '#rrggbb'] [--palette c,c,...]   if the setting is on
#   aequalyn-browser-theme on [--color '#rrggbb'] [--palette c,c,...]     now
#   aequalyn-browser-theme off                        remove it again
#
# Chromium, Chrome, Edge, Brave, Vivaldi and their like take it from a policy; Firefox, Zen,
# LibreWolf, Waterfox and Floorp from a style sheet in each of your profiles (no root needed;
# they read it as they start).
#
# Chromium only reads its frame colour from a system-wide managed policy, so the
# bar's base colour (bgBase) is published as BrowserThemeColor there. No
# BrowserColorScheme key: it is not a valid Chromium policy (browsers report it
# as an error) and the colour works on its own.
#
# AUTHORISATION: one gate, the same one every plugin uses. The user half
# stages the colour and calls aequalyn-watchdog exec-root (an approval window
# naming the command, the password going to sudo on a pipe); the root half is
# only ever started by the watchdog (gate-publish / gate-clear), re-finds the
# staged colour through SUDO_USER's home, validates it, and writes the
# policies itself. No pkexec, no sudo -A, no askpass. These two halves are among the
# few commands aequalyn-gate-rules lets run without the password (a hex colour is all
# they take); without those rules the approval window asks.

set -uo pipefail

SETTINGS="${XDG_CONFIG_HOME:-$HOME/.config}/aequalyn/settings.json"
SELF="$(readlink -f "$0")"
STAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/aequalyn/gate"
STAGE_FILE="$STAGE_DIR/browser-theme.json"

log() { printf '\033[0;34m[aequalyn-browser-theme]\033[0m %s\n' "$*" >&2; }

# ---- root half: the only part that touches /etc ----------------------------
if [[ ${1:-} == "--root" ]]; then
    shift
    action="${1:-}"; shift || true
    case "$action" in
        write)
            color="${1:-}"; shift || true
            [[ $color =~ ^#[0-9a-fA-F]{6}$ ]] || exit 1
            payload=$(printf '{"BrowserThemeColor": "%s"}\n' "$color")
            for dir in "$@"; do
                [[ -n $dir ]] || continue
                mkdir -p "$dir" 2>/dev/null || continue
                # The browser runs as the desktop user. mkdir -p inherits root's
                # umask, which can leave /etc/opt, /etc/chromium and friends at
                # 0700: the file is 0644 but nobody can traverse to it, and the
                # user half cannot see it either (so it asks again every time).
                # Make every /etc component on the way to the policy dir
                # traversable/readable before writing the file.
                component="$dir"
                while [[ $component == /etc || $component == /etc/* ]]; do
                    chmod 755 "$component" 2>/dev/null || true
                    [[ $component == /etc ]] && break
                    component="${component%/*}"
                done
                printf '%s' "$payload" > "$dir/color.json" 2>/dev/null || continue
                chown root:root "$dir/color.json" 2>/dev/null || true
                chmod 644 "$dir/color.json" 2>/dev/null || true
            done
            ;;
        remove)
            for dir in "$@"; do
                [[ -n $dir ]] || continue
                rm -f "$dir/color.json" 2>/dev/null || true
            done
            ;;
        *) exit 1 ;;
    esac
    exit 0
fi

# ---- the gate halves, run as root by the watchdog's exec-root ---------------
# The watchdog starts these with a fixed argv; everything they need from the
# user's side was staged in a file they re-find through SUDO_USER (sudo resets
# HOME, but always keeps SUDO_USER), and they trust nothing in it beyond
# strict validation: the colour must be a hex pair, the directories are
# recomputed here, as root, never taken from the file.
gate_root_home() {
    local user="${SUDO_USER:-}" home=""
    [[ -n $user ]] || { log "no SUDO_USER: not started by the gate"; exit 1; }
    home=$(getent passwd "$user" | cut -d: -f6)
    [[ -n $home ]] || { log "no home for $user"; exit 1; }
    printf '%s' "$home"
}

if [[ ${1:-} == "gate-publish" || ${1:-} == "gate-clear" ]]; then
    export PATH=/usr/bin:/usr/local/bin
    [[ ${EUID} -eq 0 ]] || { log "gate halves need root"; exit 1; }
    home=$(gate_root_home)
    stage="$home/.local/state/aequalyn/gate/browser-theme.json"
    color=""
    if [[ ${1:-} == "gate-publish" ]]; then
        color=$(jq -r '.color // empty' "$stage" 2>/dev/null || true)
        [[ $color =~ ^#[0-9a-fA-F]{6}$ ]] || { log "staged colour is missing or invalid"; exit 1; }
    fi
    mapfile -t dirs < <(
        find /etc -type d -path '*/policies/managed' -print 2>/dev/null | sort -u
        for pair in \
            "chromium:/etc/chromium/policies/managed" \
            "chromium-browser:/etc/chromium/policies/managed" \
            "google-chrome:/etc/opt/chrome/policies/managed" \
            "google-chrome-stable:/etc/opt/chrome/policies/managed" \
            "google-chrome-beta:/etc/opt/chrome/policies/managed" \
            "microsoft-edge:/etc/opt/edge/policies/managed" \
            "microsoft-edge-stable:/etc/opt/edge/policies/managed" \
            "microsoft-edge-dev:/etc/opt/edge/policies/managed" \
            "brave:/etc/brave/policies/managed" \
            "brave-browser:/etc/brave/policies/managed" \
            "vivaldi:/etc/vivaldi/policies/managed" \
            "vivaldi-stable:/etc/vivaldi/policies/managed" \
            "opera:/etc/opt/opera/policies/managed" \
            "yandex-browser:/etc/yandex-browser/policies/managed"; do
            cmd=${pair%%:*}; dir=${pair#*:}
            command -v "$cmd" >/dev/null 2>&1 && printf '%s\n' "$dir"
        done | sort -u
    )
    if [[ ${1:-} == "gate-publish" ]]; then
        "$SELF" --root write "$color" "${dirs[@]}"
        log "published $color to ${#dirs[@]} browser polic(ies)"
    else
        "$SELF" --root remove "${dirs[@]}"
        log "removed the colour policy from ${#dirs[@]} browser polic(ies)"
    fi
    exit 0
fi

# ---- user half --------------------------------------------------------------
action="${1:-sync}"; shift || true
color=""; colors=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --color) color="${2:-}"; shift 2 ;;
        --palette) colors="${2:-}"; shift 2 ;;
        --prompt) shift ;;   # kept for compatibility; always interactive now
        *) shift ;;
    esac
done

current_color() {
    local tc id="" c=""
    tc=$(cat "$HOME/.config/quickshell/theme.conf" 2>/dev/null || true)
    # theme.conf is authoritative: in wallpaper mode `aequalyn-themes current`
    # stays at the last folder theme, which would publish a stale colour.
    if [[ $tc == theme:* ]]; then
        id=${tc#theme:}
    elif [[ $tc != wallpaper ]] && command -v aequalyn-themes >/dev/null 2>&1; then
        id=$(aequalyn-themes current 2>/dev/null || true)
    fi
    if [[ -n $id ]] && command -v aequalyn-themes >/dev/null 2>&1; then
        c=$(aequalyn-themes list --json 2>/dev/null \
            | jq -r --arg id "$id" '(.[]? | select(.id == $id) | .palette.bgBase // empty)' \
            2>/dev/null | head -1 || true)
    fi
    if [[ -z $c ]]; then
        c=$(jq -r '.bgBase // empty' \
            "$HOME/.config/quickshell/theme-switcher/wallpaper-theme.json" 2>/dev/null || true)
    fi
    if [[ -z $c ]]; then
        c=$(jq -r '.background // .bgBase // empty' "$HOME/.cache/aequalyn/colors.json" 2>/dev/null || true)
    fi
    [[ $c =~ ^#?[0-9a-fA-F]{6}$ ]] || c="#121515"
    [[ $c == \#* ]] || c="#$c"
    printf '%s' "${c,,}"
}

# the theme's colours for Firefox, when the shell did not say them
current_palette() {
    local tc id keys='[.bgBase, .bgSurface, .bgHover, .bgBorder, .textPrimary, .textMuted, .accentPrimary] | map(. // "") | join(",")'
    tc=$(cat "$HOME/.config/quickshell/theme.conf" 2>/dev/null || true)
    if [[ $tc == theme:* ]]; then
        id=${tc#theme:}
        aequalyn-themes list --json 2>/dev/null | jq -r --arg id "$id" "(.[]? | select(.id == \$id) | .palette // {}) | $keys" 2>/dev/null | head -1 || true
    else
        jq -r "$keys" "$HOME/.config/quickshell/theme-switcher/wallpaper-theme.json" 2>/dev/null || true
    fi
}

policy_dirs() {
    local dirs=() dir
    # Every Chromium-style managed-policy directory that exists on this machine
    # gets color.json -- Chrome, Chromium, Edge, Brave, Vivaldi, Opera, etc.
    while IFS= read -r dir; do
        [[ -n $dir ]] && dirs+=("$dir")
    done < <(find /etc -type d -path '*/policies/managed' -print 2>/dev/null | sort -u)

    # Also create the dirs for supported browsers that are installed but do not
    # have a policy dir yet, so they pick up the colour on their first launch.
    local pair cmd
    for pair in \
        "chromium:/etc/chromium/policies/managed" \
        "chromium-browser:/etc/chromium/policies/managed" \
        "google-chrome:/etc/opt/chrome/policies/managed" \
        "google-chrome-stable:/etc/opt/chrome/policies/managed" \
        "google-chrome-beta:/etc/opt/chrome/policies/managed" \
        "microsoft-edge:/etc/opt/edge/policies/managed" \
        "microsoft-edge-stable:/etc/opt/edge/policies/managed" \
        "microsoft-edge-dev:/etc/opt/edge/policies/managed" \
        "brave:/etc/brave/policies/managed" \
        "brave-browser:/etc/brave/policies/managed" \
        "vivaldi:/etc/vivaldi/policies/managed" \
        "vivaldi-stable:/etc/vivaldi/policies/managed" \
        "opera:/etc/opt/opera/policies/managed" \
        "yandex-browser:/etc/yandex-browser/policies/managed"; do
        cmd=${pair%%:*}; dir=${pair#*:}
        command -v "$cmd" >/dev/null 2>&1 || continue
        [[ " ${dirs[*]:-} " == *" $dir "* ]] || dirs+=("$dir")
    done
    printf '%s\n' "${dirs[@]}"
}

# Ask through the gate: stage the colour, then aequalyn-watchdog exec-root
# (an approval window names the command; the password goes to sudo on a
# pipe). A denial or a timeout leaves everything as it was.
stage_gate() {
    mkdir -p "$STAGE_DIR"
    printf '{"color": "%s"}\n' "$color" > "$STAGE_FILE"
}
gate_run() { # <action>
    local reply rc=0
    reply=$(aequalyn-watchdog exec-root --as settings "$1" 2>&1) || rc=$?
    if [[ $rc -ne 0 ]]; then
        if printf '%s' "$reply" | grep -q "not a supervised process"; then
            log "the gate only answers the desktop; from a terminal run it yourself:"
            log "    sudo $SELF --root write '$color' \$(find /etc -type d -path '*/policies/managed')"
            return 1
        fi
        log "the gate answered: $(printf '%s' "$reply" | tail -n +2 | tr -d '\n ' | cut -c1-160)"
        return $rc
    fi
    return 0
}
write_policy() { stage_gate; gate_run browser-theme-publish || return 1; }
remove_policy() { gate_run browser-theme-clear || return 1; }

# Skip the prompt when every policy file already holds the requested colour.
policy_has() {
    local want=$1 dir n=0
    for dir in "${dirs[@]}"; do
        [[ -f "$dir/color.json" ]] || return 1
        grep -q "\"BrowserThemeColor\": \"$want\"" "$dir/color.json" 2>/dev/null || return 1
        n=$((n + 1))
    done
    [[ $n -gt 0 ]]
}
policy_any() {
    local dir
    for dir in "${dirs[@]}"; do [[ -f "$dir/color.json" ]] && return 0; done
    return 1
}

# ---- Firefox and its like: a style sheet in each profile ---------------------
# Three things, and nothing of yours: chrome/aequalyn.css (ours whole), one @import line at the
# top of chrome/userChrome.css, and one pref in user.js that has the browser read it.
IMPORT='@import "aequalyn.css"; /* Aequalyn */'
PREF='user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true); // Aequalyn'
gecko_profiles() {
    local root
    for root in "$HOME/.mozilla/firefox" "${XDG_CONFIG_HOME:-$HOME/.config}/mozilla/firefox" "$HOME/.zen" "${XDG_CONFIG_HOME:-$HOME/.config}/zen" \
                "$HOME/.librewolf" "$HOME/.waterfox" "$HOME/.floorp" "$HOME/.var/app/org.mozilla.firefox/.mozilla/firefox" \
                "$HOME/.var/app/app.zen_browser.zen/.zen" "$HOME/.var/app/io.gitlab.librewolf-community/.librewolf"; do
        [[ -f "$root/profiles.ini" ]] || continue
        sed -n 's/^Path=//p' "$root/profiles.ini" | while IFS= read -r p; do
            p=${p%$'\r'}
            [[ "$p" == /* ]] || p="$root/$p"
            [[ -d "$p" ]] && printf '%s\n' "$p"
        done
    done
}
gecko_on() {
    local base surface hover border text muted accent c p css
    [[ -n "$colors" ]] || colors=$(current_palette)
    IFS=, read -r base surface hover border text muted accent <<< "$colors"
    for c in "$base" "$surface" "$hover" "$border" "$text" "$muted" "$accent"; do
        [[ "$c" =~ ^#[0-9a-fA-F]{6}$ ]] || return 0          # no whole palette: left as it is
    done
    [[ -n "$(gecko_profiles | head -1)" ]] || return 0
    css="/* Written by aequalyn-browser-theme: your desktop's colours. Not for editing: your own go in userChrome.css. */
:root, :root[lwtheme], :root:not([lwtheme]) {
  --toolbox-bgcolor: $base !important; --toolbox-bgcolor-inactive: $base !important;
  --lwt-accent-color: $base !important; --lwt-accent-color-inactive: $base !important; --lwt-text-color: $text !important;
  --toolbar-bgcolor: $surface !important; --toolbar-color: $text !important; --toolbar-field-background-color: $base !important;
  --toolbar-field-color: $text !important; --toolbar-field-focus-background-color: $base !important; --toolbar-field-focus-color: $text !important;
  --toolbar-field-border-color: $border !important; --toolbar-field-focus-border-color: $accent !important;
  --tab-selected-bgcolor: $surface !important; --tab-selected-textcolor: $text !important; --tab-hover-background-color: $hover !important;
  --lwt-tab-line-color: $accent !important; --tab-loading-fill: $accent !important;
  --arrowpanel-background: $surface !important; --arrowpanel-color: $text !important; --arrowpanel-border-color: $border !important;
  --urlbarView-background: $surface !important; --urlbarView-highlight-background: $hover !important; --urlbarView-highlight-color: $text !important;
  --sidebar-background-color: $base !important; --sidebar-text-color: $text !important; --chrome-content-separator-color: $border !important;
  --toolbarbutton-icon-fill: $text !important; --toolbarbutton-hover-background: $hover !important; --toolbarbutton-active-background: $hover !important;
  --focus-outline-color: $accent !important; --color-accent-primary: $accent !important; --button-primary-bgcolor: $accent !important; --button-primary-color: $base !important;
  --zen-primary-color: $accent !important; --zen-main-browser-background: $base !important; --zen-colors-primary: $surface !important; --zen-colors-border: $border !important;
}
#navigator-toolbox, #TabsToolbar, #titlebar { background-color: $base !important; color: $text !important; }
#nav-bar, #PersonalToolbar { background-color: $surface !important; color: $text !important; }
.tab-label { color: $text !important; } .tabbrowser-tab:not([selected]) .tab-label { color: $muted !important; }"
    while IFS= read -r p; do
        mkdir -p "$p/chrome" || continue
        [[ "$(cat "$p/chrome/aequalyn.css" 2>/dev/null)" == "$css" ]] || printf '%s\n' "$css" > "$p/chrome/aequalyn.css"
        if ! grep -qF "$IMPORT" "$p/chrome/userChrome.css" 2>/dev/null; then
            # an @import counts only before everything else (a @charset aside)
            { printf '%s\n' "$IMPORT"; cat "$p/chrome/userChrome.css" 2>/dev/null || true; } > "$p/chrome/userChrome.css.aq" \
                && mv -f "$p/chrome/userChrome.css.aq" "$p/chrome/userChrome.css"
        fi
        grep -qF "$PREF" "$p/user.js" 2>/dev/null || printf '%s\n' "$PREF" >> "$p/user.js"
    done < <(gecko_profiles | sort -u)
}
gecko_off() {
    local p f
    while IFS= read -r p; do
        rm -f "$p/chrome/aequalyn.css"
        for f in "$p/chrome/userChrome.css" "$p/user.js"; do
            [[ -f "$f" ]] || continue
            grep -vF -e "$IMPORT" -e "$PREF" "$f" > "$f.aq" || true
            if [[ -s "$f.aq" ]]; then mv -f "$f.aq" "$f"; else rm -f "$f.aq" "$f"; fi
        done
    done < <(gecko_profiles | sort -u)
}

refresh_browsers() {
    local cmd running name
    running=$(ps -u "$(id -u)" -o args= 2>/dev/null || true)
    for cmd in google-chrome google-chrome-stable google-chrome-beta \
               chromium chromium-browser microsoft-edge microsoft-edge-stable \
               microsoft-edge-dev brave brave-browser vivaldi vivaldi-stable \
               opera yandex-browser; do
        command -v "$cmd" >/dev/null 2>&1 || continue
        # one that is not open reads it as it starts: it is not started for that
        name=${cmd%-stable}; name=${name%-beta}; name=${name%-dev}; name=${name%-browser}
        case "$name" in google-chrome) name=chrome ;; microsoft-edge) name=msedge ;; esac
        grep -qE "(^|/)$name(-bin)?([ /]|\$)" <<< "$running" || continue
        "$cmd" --refresh-platform-policy --no-startup-window >/dev/null 2>&1 &
    done
    true
}

mapfile -t dirs < <(policy_dirs)

case "$action" in
    sync)
        enabled=$(jq -r '.appearance.themeBrowser // false' "$SETTINGS" 2>/dev/null || echo false)
        [[ $enabled == true ]] || exit 0
        [[ -n $color ]] || color=$(current_color)
        gecko_on
        policy_has "$color" && exit 0
        write_policy || true
        ;;
    on)
        [[ -n $color ]] || color=$(current_color)
        gecko_on
        policy_has "$color" && exit 0
        write_policy || true
        ;;
    off)
        gecko_off
        policy_any || exit 0
        remove_policy || true
        ;;
    *)
        log "usage: $0 {sync|on|off} [--color '#rrggbb']"
        exit 2
        ;;
esac

refresh_browsers

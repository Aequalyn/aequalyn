#!/usr/bin/env python3
import os, glob, json, subprocess

dirs = ["/usr/share/applications", os.path.expanduser("~/.local/share/applications")]
cats = {
    "textEditor": ["TextEditor"],
    "browser": ["WebBrowser"],
    "videoPlayer": ["VideoPlayer", "Player"],
    "terminal": ["TerminalEmulator"],
    "fileManager": ["FileManager"],
}
apps = {k: [] for k in cats}
seen = set()

for d in dirs:
    for p in glob.glob(os.path.join(d, "*.desktop")):
        try:
            lines = open(p, encoding="utf-8", errors="ignore").read().splitlines()
        except Exception:
            continue
        data = {}
        inentry = False
        for l in lines:
            if l.strip().startswith("["):
                inentry = l.strip() == "[Desktop Entry]"
                continue
            if not inentry or "=" not in l or l.startswith("#"):
                continue
            k, v = l.split("=", 1)
            if k.strip() not in data:
                data[k.strip()] = v.strip()
        if data.get("Type") != "Application" or data.get("NoDisplay") == "true" or data.get("Hidden") == "true":
            continue
        name = data.get("Name")
        did = os.path.basename(p)
        if not name:
            continue
        c = data.get("Categories", "")
        for key, kws in cats.items():
            if any(kw in c for kw in kws):
                if did not in seen:
                    apps[key].append({"id": did, "name": name})
                    seen.add(did)

def q(mime):
    try:
        return subprocess.check_output(["xdg-mime", "query", "default", mime],
                                      text=True, stderr=subprocess.DEVNULL).strip()
    except Exception:
        return ""

current = {
    "textEditor": q("text/plain"),
    "browser": q("text/html"),
    "videoPlayer": q("video/mp4"),
    "fileManager": q("inode/directory"),
}

term = ""
cfg = os.path.expanduser("~/.config/xdg-terminals.list")
if os.path.exists(cfg):
    for l in open(cfg):
        l = l.strip()
        if l and not l.startswith("#"):
            term = l
            break
if not term:
    term = os.environ.get("TERMINAL", "")
current["terminal"] = term

print(json.dumps({"apps": apps, "current": current}))
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/aequalyn.txt",
    "width": 46,
    "padding": { "right": 2 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "cyan", "title": "magenta" },
    "key": { "width": 12, "type": "string" },
    "percent": { "type": 3 }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "Aequalyn", "format": "{name} {version}" },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "theme",
    "icons",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "battery",
    "locale",
    "break",
    "colors"
  ]
}

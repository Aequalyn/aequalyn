{
  "version": 1,
  "appearance": {
    "themeMode": "wallpaper",
    "themeApps": true,
    "themeBrowser": true,
    "barHeight": 32,
    "barOpacity": 100,
    "showClock": true,
    "showCalendar": true,
    "showWorkspaces": true,
    "workspaceCount": 5,
    "workspaceLabelStyle": "numbers",
    "workspaceShowEmpty": true,
    "showMedia": true,
    "showVolume": true,
    "showBrightness": true,
    "showCpu": true,
    "showNetwork": true,
    "showBattery": true,
    "showTemperature": true,
    "showTray": true,
    "clockSeconds": false,
    "use24h": true,
    "showBarDate": true,
    "clockDateFormat": "ddd MMM d",
    "clockLeftClick": "calendar",
    "clockRightClick": "clock-settings",
    "wallpaperPath": "",
    "pluginOrder": [
      "appsmenu",
      "workspaces",
      "layouts",
      "network",
      "atelier",
      "clock",
      "calendar",
      "media",
      "title",
      "battery",
      "volume",
      "brightness",
      "cpu",
      "bluetooth",
      "temperature",
      "caffeine",
      "tray",
      "screenrecorder",
      "screenshot",
      "power",
      "settingsbutton",
      "plume",
      "altscape"
    ],
    "showBluetooth": true,
    "showSettingsButton": true,
    "showAppsMenu": true,
    "showPower": true,
    "showScreenRecorder": true,
    "showScreenshot": true,
    "showTitle": true,
    "barLeft": [
      "appsmenu",
      "workspaces",
      "layouts",
      "network",
      "atelier"
    ],
    "barCenter": [
      "clock",
      "calendar",
      "media",
      "title",
      "battery",
      "volume"
    ],
    "barRight": [
      "brightness",
      "cpu",
      "bluetooth",
      "temperature",
      "caffeine",
      "tray",
      "screenrecorder",
      "screenshot",
      "power",
      "clipscape",
      "settingsbutton",
      "plume",
      "altscape"
    ],
    "showCaffeine": true,
    "showAtelier": true,
    "showLayouts": true,
    "showClipscape": true
  },
  "hyprland": {
    "gapsIn": 5,
    "gapsOut": 10,
    "borderSize": 2,
    "rounding": 12,
    "activeOpacity": 1,
    "inactiveOpacity": 0.95,
    "blurEnabled": true,
    "blurSize": 6,
    "animationsEnabled": true,
    "layout": "dwindle",
    "naturalScroll": true,
    "kbLayout": "us",
    "followMouse": 1,
    "sensitivity": 0
  },
  "power": {
    "lockEnabled": true,
    "lockMinutes": 5,
    "screenOffEnabled": true,
    "screenOffMinutes": 6,
    "suspendEnabled": true,
    "suspendMinutes": 15
  },
  "dock": {
    "enabled": true,
    "position": "bottom",
    "autohide": false,
    "pinned": [
      "aequalyn.fm",
      "firefox",
      "chromium",
      "kitty"
    ],
    "iconSize": 40,
    "screen": "all"
  },
  "wallpaper": {
    "mode": "static",
    "folder": "~/Pictures/Wallpapers",
    "interval": 30,
    "order": "shuffle",
    "outputs": "same",
    "transition": "fade",
    "transitionDuration": 1,
    "transitionFps": 60,
    "daytime": {
      "dawn": 6,
      "day": 9,
      "dusk": 18,
      "night": 21
    },
    "workspaces": {},
    "workspacePalette": false,
    "liveOptions": "no-audio loop panscan=1.0 hwdec=auto"
  },
  "palette": {
    "locked": false,
    "mode": "dark",
    "lightFrom": 7,
    "darkFrom": 19,
    "scheme": "scheme-tonal-spot",
    "contrast": 0
  },
  "atelier": {
    "layouts": {
      "themes": "grid",
      "wallpapers": "carousel"
    },
    "livePreview": true,
    "openAs": "panel",
    "panelWidth": 1180,
    "panelHeight": 780,
    "atelierShowName": true,
    "atelierRightClick": "next-wallpaper",
    "atelierMiddleClick": "random-wallpaper",
    "layoutsShowName": true,
    "layoutsRightClick": "next-layout",
    "layoutsMiddleClick": "prev-layout"
  },
  "layouts": {
    "default": "dwindle",
    "workspaces": {},
    "cycle": [],
    "pane": 0.62,
    "middle": 0.56,
    "gap": 24,
    "notify": true
  },
  "barStyle": {
    "enabled": true,
    "shape": "full",
    "chips": true
  },
  "plugins": [
    "bar",
    "appLauncher",
    "defaultApps",
    "programsMenu",
    "notifications",
    "atelier",
    "osd",
    "monitorManager",
    "idleInhibitor",
    "lock",
    "clipscape",
    "powerMenu",
    "docks",
    "fm",
    "settings"
  ]
}
